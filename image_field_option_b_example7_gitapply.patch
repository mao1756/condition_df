+    "    probs = _softmax_np(logits)\n",
+    "    labels = np.asarray(generated.labels, dtype=np.int64)\n",
+    "    pred = np.argmax(probs, axis=1)\n",
+    "    target_probability = probs[np.arange(len(labels)), labels]\n",
